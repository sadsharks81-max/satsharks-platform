            "text": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\" />\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/corn-blue.svg\" />\n    <link rel=\"apple-touch-icon\" href=\"/corn-blue.svg\" />\n    \n    <title>Bluecorn</title>\n    \n    <meta name=\"description\" content=\"Master the Digital SAT with Bluebooky. Take full-length adaptive mock exams with realistic Bluebook interface timers, tools, and College Board-style algorithms.\" />\n    \n    <meta name=\"keywords\" content=\"Bluebooky, Bluecorn, College Board, Bluebook, Digital SAT, SAT practice test, SAT adaptive, Mock SAT test, College Board Bluebook alternative, SAT Math grid-ins, Reading and writing SAT, free Digital SAT simulator\" />\n    <meta name=\"author\" content=\"Bluecorn.org\" />\n    <meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" />\n\n    <meta property=\"og:title\" content=\"Bluebooky\" />\n    <meta property=\"og:description\" content=\"Experience a flawlessly identical digital SAT environment.\" />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta property=\"og:url\" content=\"https://bluecorn.org\" />\n    <meta property=\"og:site_name\" content=\"Bluebooky\" />\n\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n    <meta name=\"twitter:title\" content=\"Bluebooky\" />\n    <meta name=\"twitter:description\" content=\"Start taking rigorous digital SAT tests matched identically to official Exams!\" />\n\n    <meta name=\"theme-color\" content=\"#3B82F6\" />\n    <meta name=\"application-name\" content=\"Bluebooky Engine\" />\n\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n\n    <script type=\"application/ld+json\">\n      {\n        