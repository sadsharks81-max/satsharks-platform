# Copy to .env (git-ignored) and fill in. Never commit real values.

NODE_ENV=development

# --- API ---
PORT=4000
# Origin of the web app, used for CORS
CLIENT_URL=http://localhost:3000
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=

# --- Database (MongoDB Atlas connection string) ---
MONGODB_URI=
# Optional: DNS servers for Node, if the local router fails SRV lookups (querySrv ENODATA)
DNS_SERVERS=

# --- Web (Next.js proxies /api/* to this URL) ---
API_URL=http://localhost:4000

# --- Background jobs (optional in Phase 1) ---
REDIS_URL=

# --- S3-compatible object storage (not used in Phase 1) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Import source ---
# Name stored on imported papers/questions, and the API host whose RPC calls are read from a HAR file.
SOURCE_NAME=bluecorn
SOURCE_API_HOST=ciao.bluebooky.org

# --- Import source: live API mode (npm run collect:bank) ---
# The source site's publishable API key (the "apikey" request header in DevTools).
SOURCE_API_KEY= 
# Your own session token from the source site. Expires after 1 hour. Never commit it.
SOURCE_ACCESS_TOKEN=
# Pause between requests, in milliseconds.
SOURCE_REQUEST_DELAY_MS=1500

# --- Email (Resend): password-reset emails ---
# API key from resend.com -> API Keys. Without it, development prints reset links to the API console.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. SAT Sharks <no-reply@yourdomain.com>
RESEND_FROM_EMAIL=
