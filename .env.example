# Copy to .env (git-ignored) and fill in. Never commit real values.

NODE_ENV=development

# --- API ---
PORT=4000
# Origin of the web app, used for CORS
CLIENT_URL=http://localhost:3000
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=

# --- Database (MongoDB Atlas connection string) ---
MONGODB_URI=
# Optional: DNS servers for Node, if the local router fails SRV lookups (querySrv ENODATA)
DNS_SERVERS=

# --- Web (Next.js proxies /api/* to this URL) ---
API_URL=http://localhost:4000

# --- Background jobs (optional in Phase 1) ---
REDIS_URL=

# --- S3-compatible object storage (not used in Phase 1) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Import source ---
# Name stored on imported papers/questions, and the API host whose RPC calls are read from a HAR file.
SOURCE_NAME=bluecorn
SOURCE_API_HOST=ciao.bluebooky.org

# --- Import source: live API mode (npm run collect:bank) ---
# The source site's publishable API key (the "apikey" request header in DevTools).
SOURCE_API_KEY= 
# Your own session token from the source site. Expires after 1 hour. Never commit it.
SOURCE_ACCESS_TOKEN=
# Pause between requests, in milliseconds.
SOURCE_REQUEST_DELAY_MS=1500

# --- Email (Resend): password-reset emails ---
# API key from resend.com -> API Keys. Without it, development prints reset links to the API console.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. SAT Sharks <no-reply@yourdomain.com>
RESEND_FROM_EMAIL=

# Streak reminders and the weekly progress email (sent by the API when Resend is set up).
# "off" stops them, e.g. on a second API instance or a test copy of the database.
ENGAGEMENT_EMAILS=on

# --- Week 4: payments, scheduler (API) ---
# Where "new payment" alerts go if Admin -> Settings -> Payments has no alert email (e.g. the owner's Gmail).
PAYMENT_ALERT_EMAIL=
# "on" turns on the pretend card gateway (no money) to try the payment flow. Refused in production.
PAYMENTS_TEST_GATEWAY=off
# Scheduled publishing, friend-invite rewards, renewal and come-back emails, removing accounts
# deleted over 30 days ago. "off" on a second API instance or a test copy of the database.
SCHEDULER=on

# --- Week 4: SEO (web, read at build time; set them in Vercel) ---
# The public address at launch, e.g. https://satsharks.com (canonical links, sitemap, social previews).
NEXT_PUBLIC_SITE_URL=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Empty = no analytics.
NEXT_PUBLIC_GA_ID=
# Google Search Console "HTML tag" verification code (the content="..." value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
